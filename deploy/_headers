# Netlify response headers for the public site. tools/export.ts copies this file into dist/.
# Same rules as serve.ts: the page is checked on every visit, the bundle is kept for good under
# its ?v=<hash> address, media and fonts for a day. Each rule repeats nosniff: Netlify may apply
# only the most specific rule for a path.
/*
  X-Content-Type-Options: nosniff
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/app.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/app.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/media/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
/fonts/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
