# Netlify response headers for the public site. tools/export.ts copies this file into dist/.
# Same rules as serve.ts: the page is checked on every visit, the bundle is kept for good under
# its ?v=<hash> address, media and fonts for a day.
/*
  X-Content-Type-Options: nosniff
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: public, max-age=31536000, immutable
/app.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=86400
